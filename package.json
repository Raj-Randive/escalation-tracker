{
  "dependencies": {
    "@sap/cds": "^10.1.1",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4"
  },
  "workspaces": [
    "app/*"
  ],
  "devDependencies": {
    "@cap-js/sqlite": "^3.1.1",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "watch-escalations": "cds watch --open escalations/index.html?sap-ui-xx-viewCache=false --livereload false",
    "start": "cds-serve",
    "watch": "cds watch"
  },
  "sapux": [
    "app/escalations"
  ],
  "name": "escalation-tracker",
  "version": "1.0.0",
  "private": true,
  "cds": {
    "requires": {
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "agent": {
              "password": "agent",
              "roles": [
                "Agent"
              ]
            },
            "manager": {
              "password": "manager",
              "roles": [
                "Manager"
              ]
            },
            "guest": {
              "password": "guest",
              "roles": []
            },
            "*": false
          }
        }
      },
      "API_BUSINESS_PARTNER": {
        "kind": "odata-v2",
        "model": "srv/external/API_BUSINESS_PARTNER"
      }
    }
  }
}