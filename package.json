{
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^10.1.1",
    "@sap/xssec": "^4"
  },
  "workspaces": [
    "app/*"
  ],
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^3.1.1",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "watch-escalations": "cds watch --open escalations/index.html?sap-ui-xx-viewCache=false --livereload false",
    "start": "cds-serve",
    "watch": "cds watch",
    "test": "node --test \"test/**/*.test.js\""
  },
  "sapux": [
    "app/escalations"
  ],
  "name": "escalation-tracker",
  "version": "1.0.0",
  "private": true,
  "cds": {
    "requires": {
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "agent": {
              "password": "agent",
              "roles": [
                "Agent"
              ]
            },
            "manager": {
              "password": "manager",
              "roles": [
                "Manager"
              ]
            },
            "guest": {
              "password": "guest",
              "roles": []
            },
            "*": false
          }
        }
      },
      "API_BUSINESS_PARTNER": {
        "kind": "odata-v2",
        "model": "srv/external/API_BUSINESS_PARTNER",
        "[production]": {
          "credentials": {
            "destination": "API_BUSINESS_PARTNER",
            "path": "/s4hanacloud/sap/opu/odata/sap/API_BUSINESS_PARTNER"
          }
        }
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        },
        "db": "hana"
      },
      "destinations": true,
      "html5-repo": true
    }
  }
}
